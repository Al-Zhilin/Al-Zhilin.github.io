---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import profile from '../data/profile.json';

const projects = (await getCollection('projects')).sort(
	(a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout title={`${profile.name} — ${profile.role}`} description={profile.bio[0]}>
	<Header />
	<main>
		<section class="relative overflow-hidden border-b border-border">
			<div class="pointer-events-none absolute inset-0 -z-10 bg-hero-glow"></div>
			<div id="hero-canvas" class="pointer-events-none absolute inset-0 -z-10"></div>
			<div class="mx-auto flex max-w-4xl flex-col gap-6 px-6 py-24 sm:py-32">
				<p class="font-mono text-sm text-accent">{profile.role}</p>
				<h1 class="text-4xl font-medium tracking-tight text-fg sm:text-5xl">{profile.name}</h1>
				<div class="flex flex-wrap gap-4 pt-2">
					<a
						href="#projects"
						class="rounded-lg border border-accent bg-accent px-5 py-2.5 text-sm text-bg shadow-glow transition-all hover:-translate-y-0.5 hover:bg-accent-hover hover:border-accent-hover"
					>
						Смотреть проекты
					</a>
					<a
						href={profile.resumeUrl}
						class="rounded-lg border border-border bg-surface/60 px-5 py-2.5 text-sm text-fg backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:border-accent"
						target="_blank"
						rel="noreferrer"
					>
						Резюме
					</a>
				</div>
			</div>
		</section>

		<section id="about" class="border-b border-border bg-surface/30">
			<div class="mx-auto flex max-w-4xl flex-col gap-6 px-6 py-20">
				<h2 class="text-2xl font-medium text-fg">Обо мне</h2>
				<div class="flex flex-col gap-4 text-base leading-relaxed text-muted">
					{profile.bio.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</div>
		</section>

		<section id="projects" class="border-b border-border">
			<div class="mx-auto flex max-w-4xl flex-col gap-8 px-6 py-20">
				<h2 class="text-2xl font-medium text-fg">Проекты</h2>
				<div class="grid gap-6 sm:grid-cols-2">
					{
						projects.map((project) => (
							<ProjectCard
								title={project.data.title}
								slug={project.slug}
								summary={project.data.summary}
								tags={project.data.tags}
								date={project.data.date}
							/>
						))
					}
				</div>
			</div>
		</section>

		<section id="contacts" class="bg-surface/30">
			<div class="mx-auto flex max-w-4xl flex-col gap-6 px-6 py-20">
				<h2 class="text-2xl font-medium text-fg">Контакты</h2>
				<ul class="flex flex-col gap-3 text-base text-muted">
					<li>
						Email:
						<a href={`mailto:${profile.contacts.email}`} class="text-fg transition-colors hover:text-accent">
							{profile.contacts.email}
						</a>
					</li>
					<li>
						GitHub:
						<a
							href={profile.contacts.github}
							class="text-fg transition-colors hover:text-accent"
							target="_blank"
							rel="noreferrer"
						>
							{profile.contacts.github}
						</a>
					</li>
					<li>
						Telegram:
						<a
							href={profile.contacts.telegram}
							class="text-fg transition-colors hover:text-accent"
							target="_blank"
							rel="noreferrer"
						>
							{profile.contacts.telegram}
						</a>
					</li>
				</ul>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

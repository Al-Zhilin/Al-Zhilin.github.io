---
import profile from '../data/profile.json';

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
	<div
		class="mx-auto flex max-w-4xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-muted sm:flex-row"
	>
		<p class="font-mono">&copy; {year} {profile.name}</p>
		<div class="flex items-center gap-6">
			<a href={profile.contacts.github} class="transition-colors hover:text-fg" target="_blank" rel="noreferrer">
				GitHub
			</a>
			<a href={profile.contacts.telegram} class="transition-colors hover:text-fg" target="_blank" rel="noreferrer">
				Telegram
			</a>
			<a href={`mailto:${profile.contacts.email}`} class="transition-colors hover:text-fg">Email</a>
		</div>
	</div>
</footer>
